# ─── Server ──────────────────────────────────────
PORT=3000

# ─── Database ────────────────────────────────────
DATABASE_URL=postgresql://postgres:voidmap123@localhost:5432/voidmap

# ─── JWT ─────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRY_SHORT=24h
JWT_EXPIRY_LONG=30d

# ─── OTP / Email ─────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key_here
FROM_EMAIL=onboarding@resend.dev
OTP_EXPIRY_MINUTES=5

# ─── Signal TTL ───────────────────────────────────
SIGNAL_TTL_MINUTES=30
CLEANUP_INTERVAL_MS=60000

# ─── Admin ───────────────────────────────────────
# Any user who signs up with this email is auto-promoted to admin
ADMIN_EMAIL=your_admin_email@gmail.com

# ─── CORS ────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
